{
  "name": "nextjs-mui-boilerplate",
  "version": "1.0.0",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint --max-warnings 0 .",
    "oxlint": "oxlint . --type-check --deny-warnings",
    "type-check": "tsc --noEmit",
    "prepare": "husky",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": [
      "oxlint --type-check",
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fullcalendar/daygrid": "^6.1.20",
    "@fullcalendar/interaction": "^6.1.20",
    "@fullcalendar/react": "^6.1.20",
    "@fullcalendar/timegrid": "^6.1.20",
    "@hookform/resolvers": "^5.2.1",
    "@mui/icons-material": "^7.3.1",
    "@mui/lab": "^7.0.1-beta.20",
    "@mui/material": "^7.3.1",
    "@mui/material-nextjs": "^7.3.0",
    "@mui/x-date-pickers": "^8.10.2",
    "@tanstack/react-query": "^5.90.12",
    "@tanstack/react-query-devtools": "^5.91.1",
    "@tiptap/extension-image": "^3.15.2",
    "@tiptap/extension-link": "^3.15.2",
    "@tiptap/extension-placeholder": "^3.15.2",
    "@tiptap/extension-text-align": "^3.15.2",
    "@tiptap/extension-underline": "^3.15.2",
    "@tiptap/react": "^3.15.2",
    "@tiptap/starter-kit": "^3.15.2",
    "apexcharts": "^5.3.4",
    "axios": "^1.13.2",
    "classnames": "^2.5.1",
    "dayjs": "^1.11.13",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "isomorphic-dompurify": "^2.34.0",
    "jwt-decode": "^4.0.0",
    "material-react-table": "^3.2.1",
    "next": "^16.1.1",
    "next-nprogress-bar": "^2.4.7",
    "nprogress": "^0.2.0",
    "phosphor-react": "^1.4.1",
    "react": "19.1.0",
    "react-apexcharts": "^1.7.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.62.0",
    "react-simple-maps": "^3.0.0",
    "zod": "^4.0.17",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.10",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@faker-js/faker": "^10.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/nprogress": "^0.2.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-simple-maps": "^3.0.6",
    "@typescript-eslint/eslint-plugin": "^8.50.1",
    "@typescript-eslint/parser": "^8.50.1",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "4.0.16",
    "@vitest/ui": "^4.0.16",
    "eslint": "^9",
    "eslint-config-next": "15.5.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "happy-dom": "^20.0.11",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lint-staged": "^16.2.7",
    "oxlint": "^1.35.0",
    "sass": "^1.90.0",
    "typescript": "^5",
    "vitest": "^4.0.16"
  }
}
