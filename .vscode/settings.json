{
    "workbench.colorCustomizations": {
        "activityBar.activeBackground": "#06e017",
        "activityBar.background": "#06e017",
        "activityBar.foreground": "#15202b",
        "activityBar.inactiveForeground": "#15202b99",
        "activityBarBadge.background": "#7064fb",
        "activityBarBadge.foreground": "#e7e7e7",
        "commandCenter.border": "#e7e7e799",
        "sash.hoverBorder": "#06e017",
        "statusBar.background": "#05ae12",
        "statusBar.foreground": "#e7e7e7",
        "statusBarItem.hoverBackground": "#06e017",
        "statusBarItem.remoteBackground": "#05ae12",
        "statusBarItem.remoteForeground": "#e7e7e7",
        "titleBar.activeBackground": "#05ae12",
        "titleBar.activeForeground": "#e7e7e7",
        "titleBar.inactiveBackground": "#05ae1299",
        "titleBar.inactiveForeground": "#e7e7e799"
    },
    "peacock.color": "#05ae12",
    "editor.defaultFormatter": "biomejs.biome",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit",
      "source.organizeImports.biome": "always"
    },
    "javascript.format.enable": false,
    "typescript.format.enable": false,
      "files.exclude": {
      "**/node_modules": true,
      "**/.next": true,
      "**/dist": true
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/.next": true,
      "**/dist": true
    }
}
